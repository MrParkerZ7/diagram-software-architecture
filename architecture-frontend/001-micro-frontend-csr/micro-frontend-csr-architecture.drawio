<mxCell id="L-CAPTION-build" value="Build or deploy, before any request" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#37474F;kitExempt=1;" vertex="1" parent="C-LEGEND"><mxGeometry x="140" y="360" width="300" height="40" as="geometry"/></mxCell>
<mxCell id="L-HUB-SAMPLE" value="" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;kitExempt=1;" vertex="1" parent="C-LEGEND"><mxGeometry x="20" y="440" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="L-HUB-TEXT" value="Navy tile with a gold rim: a hub, where several arrows meet (the generic router and the servers keep their own shape)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#37474F;kitExempt=1;" vertex="1" parent="C-LEGEND"><mxGeometry x="70" y="440" width="370" height="40" as="geometry"/></mxCell>
<mxCell id="L-LINE-1" value="Each part is an icon; its caption names it, and the caption's colour is its class. Numbers = the order of the steps of the flow drawn; numbered dashed steps are build steps and come before any request; an unnumbered cable stands outside that order (a build or deploy link, a standing link, or a separate trigger)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#37474F;kitExempt=1;" vertex="1" parent="C-LEGEND"><mxGeometry x="480" y="300" width="420" height="80" as="geometry"/></mxCell>
<mxCell id="L-LINE-2" value="BFF and page cache are separate choices from the rendering approach (ISR alone is built on its page cache), drawn where this example uses them; the headless CMS is a data source, not a BFF." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#37474F;kitExempt=1;" vertex="1" parent="C-LEGEND"><mxGeometry x="480" y="390" width="420" height="50" as="geometry"/></mxCell>
<mxCell id="X-B-PAGE--E-CDN" value="1 · 3 · static files:&lt;br&gt;index.html, import map /&lt;br&gt;manifest, shell, team bundles" style="edgeStyle=none;rounded=0;html=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#232F3E;strokeWidth=2;endArrow=classic;endFill=1;flowAnimation=1;shadow=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="B-PAGE" target="E-CDN"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="760"/><mxPoint x="1100" y="980"/></Array></mxGeometry></mxCell>
<mxCell id="X-B-PAGE--G-SHELL" value="2 · the shell boots" style="edgeStyle=none;rounded=0;html=1;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.888889;entryDx=0;entryDy=0;strokeColor=#232F3E;strokeWidth=2;dashed=1;dashPattern=1 3;endArrow=open;endFill=0;shadow=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="B-PAGE" target="G-SHELL"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="X-B-SHELL--G-REMOTES" value="3 · load each&lt;br&gt;remote entry,&lt;br&gt;mount it" style="edgeStyle=none;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.173913;entryDx=0;entryDy=0;strokeColor=#232F3E;strokeWidth=2;dashed=1;dashPattern=1 3;endArrow=open;endFill=0;shadow=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="B-SHELL" target="G-REMOTES"><mxGeometry x="0.2" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="X-B-PAGE--E-ROUTER" value="4 · team UIs call&lt;br&gt;the API (JSON)" style="edgeStyle=none;rounded=0;html=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;strokeColor=#232F3E;strokeWidth=2;endArrow=classic;endFill=1;flowAnimation=1;shadow=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="B-PAGE" target="E-ROUTER"><mxGeometry x="-0.2381" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="X-E-ROUTER--O-BFF" value="5 · /api routed to the BFF" style="edgeStyle=none;rounded=0;html=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.875;entryDx=0;entryDy=0;strokeColor=#232F3E;strokeWidth=2;endArrow=classic;endFill=1;flowAnimation=1;shadow=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="E-ROUTER" target="O-BFF"><mxGeometry x="0.725" relative="1" as="geometry"><Array as="points"><mxPoint x="1780" y="680"/><mxPoint x="1780" y="740"/></Array></mxGeometry></mxCell>
<mxCell id="X-O-BFF--G-APIS" value="6 · the BFF calls&lt;br&gt;the team APIs" style="edgeStyle=none;rounded=0;html=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.478261;entryDx=0;entryDy=0;strokeColor=#232F3E;strokeWidth=2;endArrow=classic;endFill=1;flowAnimation=1;shadow=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="O-BFF" target="G-APIS"><mxGeometry x="0.2941" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="X-G-SHELL--B-SHARED" value="loads one shared&lt;br&gt;React (singleton)" style="edgeStyle=none;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#232F3E;strokeWidth=2;dashed=1;dashPattern=1 3;endArrow=open;endFill=0;shadow=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="G-SHELL" target="B-SHARED"><mxGeometry x="0.1" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="X-G-CI--E-CDN" value="each team uploads its own bundle" style="edgeStyle=none;rounded=0;html=1;exitX=0.090909;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;strokeColor=#616161;strokeWidth=2;dashed=1;dashPattern=14 8;endArrow=classic;endFill=1;shadow=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="G-CI" target="E-CDN"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1740" y="1140"/><mxPoint x="1380" y="1140"/></Array></mxGeometry></mxCell>
<mxCell id="X-G-CI--D-REGISTRY" value="publishes the&lt;br&gt;new version" style="edgeStyle=none;rounded=0;html=1;exitX=0.045455;exitY=1;exitDx=0;exitDy=0;entryX=0.833333;entryY=0;entryDx=0;entryDy=0;strokeColor=#616161;strokeWidth=2;dashed=1;dashPattern=14 8;endArrow=classic;endFill=1;shadow=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="G-CI" target="D-REGISTRY"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="X-D-REGISTRY--E-CDN" value="manifest points at it" style="edgeStyle=none;rounded=0;html=1;exitX=0.333333;exitY=0;exitDx=0;exitDy=0;entryX=0.125;entryY=1;entryDx=0;entryDy=0;strokeColor=#616161;strokeWidth=2;dashed=1;dashPattern=14 8;endArrow=classic;endFill=1;shadow=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="D-REGISTRY" target="E-CDN"><mxGeometry x="0.825" relative="1" as="geometry"><Array as="points"><mxPoint x="1660" y="1160"/><mxPoint x="1280" y="1160"/></Array></mxGeometry></mxCell>
<mxCell id="L-SAMPLE-net" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=classic;endFill=1;flowAnimation=1;shadow=1;kitExempt=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1480" as="sourcePoint"/><mxPoint x="160" y="1480" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="L-SAMPLE-page" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;dashed=1;dashPattern=1 3;endArrow=open;endFill=0;shadow=1;kitExempt=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1520" as="sourcePoint"/><mxPoint x="160" y="1520" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="L-SAMPLE-build" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=1;dashPattern=14 8;endArrow=classic;endFill=1;shadow=1;kitExempt=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1560" as="sourcePoint"/><mxPoint x="160" y="1560" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="F-TITLE" value="Micro-frontends with CSR: client-side rendering (first load)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontColor=#424242;fontSize=14;fontStyle=1;verticalAlign=middle;align=center;shadow=1;kitExempt=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="3160" height="60" as="geometry"/></mxCell>
<mxCell id="F-TITLE_nl" value="" style="shape=stencil(fZBRDoMgEERPwz+F9ATWnqAX2OpaNyIQoFpvX8gaa03TL/bNDDAgdBV78CiUtDCi0BehVBpugfKaxZ6Vk5TM84EhemwSixMEgrtBdmIKbsCZ2rSeQbbHQKm4uha66lzAR3BP2zJ7KMkyjW4qhV6877xetTAyXTlpyO6SW6vlm3+G/0Yb4yJulIdPuY6M2TvHZ2SJf1TXbw==);aspect=variable;direction=west;html=1;fillColor=#616161;strokeColor=none;kitExempt=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="14" height="60" as="geometry"/></mxCell>
<mxCell id="F-TITLE_nr" value="" style="shape=stencil(fZBRDoMgEERPwz+F9ATWnqAX2OpaNyIQoFpvX8gaa03TL/bNDDAgdBV78CiUtDCi0BehVBpugfKaxZ6Vk5TM84EhemwSixMEgrtBdmIKbsCZ2rSeQbbHQKm4uha66lzAR3BP2zJ7KMkyjW4qhV6877xetTAyXTlpyO6SW6vlm3+G/0Yb4yJulIdPuY6M2TvHZ2SJf1TXbw==);aspect=variable;direction=east;html=1;fillColor=#616161;strokeColor=none;kitExempt=1;" vertex="1" parent="1"><mxGeometry x="3186" y="20" width="14" height="60" as="geometry"/></mxCell>
<mxCell id="F-S1" value="&lt;b&gt;Where the HTML is produced&lt;/b&gt;&lt;br&gt;In the browser. The CDN sends a nearly empty index.html; the DOM is built by JavaScript after the shell and the team UIs load." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#424242;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;shadow=1;kitExempt=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1000" height="120" as="geometry"/></mxCell>
<mxCell id="F-S1_fold" value="" style="shape=stencil(fZBRDoMgEERPwz+F9ATWnqAX2OpaNyIQoFpvX8gaa03TL/bNDDAgdBV78CiUtDCi0BehVBpugfKaxZ6Vk5TM84EhemwSixMEgrtBdmIKbsCZ2rSeQbbHQKm4uha66lzAR3BP2zJ7KMkyjW4qhV6877xetTAyXTlpyO6SW6vlm3+G/0Yb4yJulIdPuY6M2TvHZ2SJf1TXbw==);aspect=variable;direction=north;html=1;fillColor=#616161;strokeColor=none;kitExempt=1;" vertex="1" parent="1"><mxGeometry x="1020" y="200" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="F-S2" value="&lt;b&gt;Where and when the micro-frontends are composed&lt;/b&gt;&lt;br&gt;In the browser, at run time, on the first load: the app shell reads the registry's manifest (an import map or a Module Federation manifest), loads each team's remote entry from the CDN and mounts it." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#424242;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;shadow=1;kitExempt=1;" vertex="1" parent="1"><mxGeometry x="1120" y="100" width="1000" height="120" as="geometry"/></mxCell>
<mxCell id="F-S2_fold" value="" style="shape=stencil(fZBRDoMgEERPwz+F9ATWnqAX2OpaNyIQoFpvX8gaa03TL/bNDDAgdBV78CiUtDCi0BehVBpugfKaxZ6Vk5TM84EhemwSixMEgrtBdmIKbsCZ2rSeQbbHQKm4uha66lzAR3BP2zJ7KMkyjW4qhV6877xetTAyXTlpyO6SW6vlm3+G/0Yb4yJulIdPuY6M2TvHZ2SJf1TXbw==);aspect=variable;direction=north;html=1;fillColor=#616161;strokeColor=none;kitExempt=1;" vertex="1" parent="1"><mxGeometry x="2100" y="200" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="F-S3" value="&lt;b&gt;Trade-off for micro-frontends&lt;/b&gt;&lt;br&gt;Each team deploys its UI on its own, with no rebuild of the shell. But the first paint waits for several bundles, SEO depends on crawlers running JavaScript, and shared libraries (one React) must stay compatible singleton versions." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#424242;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;shadow=1;kitExempt=1;" vertex="1" parent="1"><mxGeometry x="2200" y="100" width="1000" height="120" as="geometry"/></mxCell>
<mxCell id="F-S3_fold" value="" style="shape=stencil(fZBRDoMgEERPwz+F9ATWnqAX2OpaNyIQoFpvX8gaa03TL/bNDDAgdBV78CiUtDCi0BehVBpugfKaxZ6Vk5TM84EhemwSixMEgrtBdmIKbsCZ2rSeQbbHQKm4uha66lzAR3BP2zJ7KMkyjW4qhV6877xetTAyXTlpyO6SW6vlm3+G/0Yb4yJulIdPuY6M2TvHZ2SJf1TXbw==);aspect=variable;direction=north;html=1;fillColor=#616161;strokeColor=none;kitExempt=1;" vertex="1" parent="1"><mxGeometry x="3180" y="200" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="F-COMPANIONS" value="&lt;b&gt;Companions (same frame):&lt;/b&gt; 002-micro-frontend-spa/micro-frontend-spa-architecture.drawio · 003-micro-frontend-mpa/micro-frontend-mpa-architecture.drawio · 004-micro-frontend-ssr/micro-frontend-ssr-architecture.drawio · 005-micro-frontend-ssg/micro-frontend-ssg-architecture.drawio · 006-micro-frontend-isr/micro-frontend-isr-architecture.drawio · 007-micro-frontend-rsc/micro-frontend-rsc-architecture.drawio" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#424242;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;shadow=1;kitExempt=1;" vertex="1" parent="1"><mxGeometry x="40" y="1760" width="3160" height="60" as="geometry"/></mxCell>
<mxCell id="F-COMPANIONS_fold" value="" style="shape=stencil(fZBRDoMgEERPwz+F9ATWnqAX2OpaNyIQoFpvX8gaa03TL/bNDDAgdBV78CiUtDCi0BehVBpugfKaxZ6Vk5TM84EhemwSixMEgrtBdmIKbsCZ2rSeQbbHQKm4uha66lzAR3BP2zJ7KMkyjW4qhV6877xetTAyXTlpyO6SW6vlm3+G/0Yb4yJulIdPuY6M2TvHZ2SJf1TXbw==);aspect=variable;direction=north;html=1;fillColor=#616161;strokeColor=none;kitExempt=1;" vertex="1" parent="1"><mxGeometry x="3180" y="1800" width="20" height="20" as="geometry"/></mxCell>
</root>
</mxGraphModel>
