<mxCell id="L-LINE-1" value="Numbers = the order of the steps of the flow drawn; numbered dashed steps are build steps and come before any request; an unnumbered cable stands outside that order (a build or deploy link, a standing link, or a separate trigger) · yellow = where the micro-frontends are composed" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#37474F;kitExempt=1;" vertex="1" parent="C-LEGEND"><mxGeometry x="20" y="280" width="760" height="60" as="geometry"/></mxCell>
