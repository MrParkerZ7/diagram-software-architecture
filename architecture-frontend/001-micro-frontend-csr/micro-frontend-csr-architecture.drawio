<mxCell id="X-E-ROUTER--O-BFF" value="5 · /api routed to the BFF" style="edgeStyle=none;rounded=0;html=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="E-ROUTER" target="O-BFF"><mxGeometry x="0.625" relative="1" as="geometry"><Array as="points"><mxPoint x="1560" y="420"/><mxPoint x="1560" y="560"/></Array></mxGeometry></mxCell>
<mxCell id="X-O-BFF--G-APIS" value="6 · the BFF calls the&lt;br&gt;team APIs" style="edgeStyle=none;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="O-BFF" target="G-APIS"><mxGeometry x="0.0769" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="X-G-CI--E-CDN" value="each team uploads its&lt;br&gt;own bundle" style="edgeStyle=none;rounded=0;html=1;exitX=0;exitY=0.875;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;strokeColor=#616161;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="G-CI" target="E-CDN"><mxGeometry x="-0.7059" relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="1320"/><mxPoint x="1080" y="980"/></Array></mxGeometry></mxCell>
<mxCell id="X-G-CI--D-REGISTRY" value="publishes the new version" style="edgeStyle=none;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#616161;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="G-CI" target="D-REGISTRY"><mxGeometry x="0.0667" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="X-D-REGISTRY--E-CDN" value="manifest points at it" style="edgeStyle=none;rounded=0;html=1;exitX=0.545455;exitY=0;exitDx=0;exitDy=0;entryX=0.461538;entryY=1;entryDx=0;entryDy=0;strokeColor=#616161;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="D-REGISTRY" target="E-CDN"><mxGeometry x="0.1818" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="L-SAMPLE-net" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;endFill=1;kitExempt=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1320" as="sourcePoint"/><mxPoint x="160" y="1320" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="L-SAMPLE-page" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;dashed=1;dashPattern=1 3;endArrow=open;endFill=0;kitExempt=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1360" as="sourcePoint"/><mxPoint x="160" y="1360" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="L-SAMPLE-build" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#616161;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;kitExempt=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1400" as="sourcePoint"/><mxPoint x="160" y="1400" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="F-TITLE" value="Micro-frontends with CSR: client-side rendering (first load)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontColor=#424242;fontSize=14;fontStyle=1;verticalAlign=middle;align=center;shadow=1;kitExempt=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2980" height="60" as="geometry"/></mxCell>
<mxCell id="F-TITLE_nl" value="" style="shape=stencil(fZBRDoMgEERPwz+F9ATWnqAX2OpaNyIQoFpvX8gaa03TL/bNDDAgdBV78CiUtDCi0BehVBpugfKaxZ6Vk5TM84EhemwSixMEgrtBdmIKbsCZ2rSeQbbHQKm4uha66lzAR3BP2zJ7KMkyjW4qhV6877xetTAyXTlpyO6SW6vlm3+G/0Yb4yJulIdPuY6M2TvHZ2SJf1TXbw==);aspect=variable;direction=west;html=1;fillColor=#616161;strokeColor=none;kitExempt=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="14" height="60" as="geometry"/></mxCell>
<mxCell id="F-TITLE_nr" value="" style="shape=stencil(fZBRDoMgEERPwz+F9ATWnqAX2OpaNyIQoFpvX8gaa03TL/bNDDAgdBV78CiUtDCi0BehVBpugfKaxZ6Vk5TM84EhemwSixMEgrtBdmIKbsCZ2rSeQbbHQKm4uha66lzAR3BP2zJ7KMkyjW4qhV6877xetTAyXTlpyO6SW6vlm3+G/0Yb4yJulIdPuY6M2TvHZ2SJf1TXbw==);aspect=variable;direction=east;html=1;fillColor=#616161;strokeColor=none;kitExempt=1;" vertex="1" parent="1"><mxGeometry x="3006" y="20" width="14" height="60" as="geometry"/></mxCell>
<mxCell id="F-S1" value="&lt;b&gt;Where the HTML is produced&lt;/b&gt;&lt;br&gt;In the browser. The CDN sends a nearly empty index.html; the DOM is built by JavaScript after the shell and the team UIs load." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#424242;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;shadow=1;kitExempt=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="940" height="120" as="geometry"/></mxCell>
<mxCell id="F-S1_fold" value="" style="shape=stencil(fZBRDoMgEERPwz+F9ATWnqAX2OpaNyIQoFpvX8gaa03TL/bNDDAgdBV78CiUtDCi0BehVBpugfKaxZ6Vk5TM84EhemwSixMEgrtBdmIKbsCZ2rSeQbbHQKm4uha66lzAR3BP2zJ7KMkyjW4qhV6877xetTAyXTlpyO6SW6vlm3+G/0Yb4yJulIdPuY6M2TvHZ2SJf1TXbw==);aspect=variable;direction=north;html=1;fillColor=#616161;strokeColor=none;kitExempt=1;" vertex="1" parent="1"><mxGeometry x="960" y="200" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="F-S2" value="&lt;b&gt;Where and when the micro-frontends are composed&lt;/b&gt;&lt;br&gt;In the browser, at run time, on the first load: the app shell reads the registry's manifest (an import map or a Module Federation manifest), loads each team's remote entry from the CDN and mounts it." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#424242;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;shadow=1;kitExempt=1;" vertex="1" parent="1"><mxGeometry x="1060" y="100" width="940" height="120" as="geometry"/></mxCell>
<mxCell id="F-S2_fold" value="" style="shape=stencil(fZBRDoMgEERPwz+F9ATWnqAX2OpaNyIQoFpvX8gaa03TL/bNDDAgdBV78CiUtDCi0BehVBpugfKaxZ6Vk5TM84EhemwSixMEgrtBdmIKbsCZ2rSeQbbHQKm4uha66lzAR3BP2zJ7KMkyjW4qhV6877xetTAyXTlpyO6SW6vlm3+G/0Yb4yJulIdPuY6M2TvHZ2SJf1TXbw==);aspect=variable;direction=north;html=1;fillColor=#616161;strokeColor=none;kitExempt=1;" vertex="1" parent="1"><mxGeometry x="1980" y="200" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="F-S3" value="&lt;b&gt;Trade-off for micro-frontends&lt;/b&gt;&lt;br&gt;Each team deploys its UI on its own, with no rebuild of the shell. But the first paint waits for several bundles, SEO depends on crawlers running JavaScript, and shared libraries (one React) must stay compatible singleton versions." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#424242;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;shadow=1;kitExempt=1;" vertex="1" parent="1"><mxGeometry x="2080" y="100" width="940" height="120" as="geometry"/></mxCell>
<mxCell id="F-S3_fold" value="" style="shape=stencil(fZBRDoMgEERPwz+F9ATWnqAX2OpaNyIQoFpvX8gaa03TL/bNDDAgdBV78CiUtDCi0BehVBpugfKaxZ6Vk5TM84EhemwSixMEgrtBdmIKbsCZ2rSeQbbHQKm4uha66lzAR3BP2zJ7KMkyjW4qhV6877xetTAyXTlpyO6SW6vlm3+G/0Yb4yJulIdPuY6M2TvHZ2SJf1TXbw==);aspect=variable;direction=north;html=1;fillColor=#616161;strokeColor=none;kitExempt=1;" vertex="1" parent="1"><mxGeometry x="3000" y="200" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="F-COMPANIONS" value="&lt;b&gt;Companions (same frame):&lt;/b&gt; 002-micro-frontend-spa/micro-frontend-spa-architecture.drawio · 003-micro-frontend-mpa/micro-frontend-mpa-architecture.drawio · 004-micro-frontend-ssr/micro-frontend-ssr-architecture.drawio · 005-micro-frontend-ssg/micro-frontend-ssg-architecture.drawio · 006-micro-frontend-isr/micro-frontend-isr-architecture.drawio · 007-micro-frontend-rsc/micro-frontend-rsc-architecture.drawio" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontColor=#424242;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;shadow=1;kitExempt=1;" vertex="1" parent="1"><mxGeometry x="40" y="1580" width="2980" height="60" as="geometry"/></mxCell>
